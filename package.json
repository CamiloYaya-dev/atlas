{
  "name": "atlas-monorepo",
  "private": true,
  "version": "4.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "setup": "npm run env:init && npm run db:up && npm run db:migrate && npm run db:seed",
    "dev:all": "npm run setup && npm run admin:ensure && npm run typecheck && npm run dev",
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm run dev -w @atlas/web",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:status": "docker compose ps db",
    "db:logs": "docker compose logs -f --tail=100 db",
    "db:migrate": "npm run db:migrate -w @atlas/api",
    "db:seed": "npm run db:seed -w @atlas/api",
    "db:backup": "node scripts/backup-db.mjs",
    "db:test": "node scripts/integration-local.mjs",
    "admin:ensure": "node scripts/ensure-admin.mjs",
    "admin:setup": "node scripts/bootstrap-admin.mjs",
    "admin:create": "npm run admin:create -w @atlas/api",
    "admin:status": "npm run admin:status -w @atlas/api",
    "typecheck": "npm run typecheck -w @atlas/api && npm run typecheck -w @atlas/web",
    "build": "npm run typecheck && npm run build:api && npm run build:web",
    "build:api": "npm run build -w @atlas/api",
    "build:web": "npm run build -w @atlas/web",
    "start:api": "npm run start -w @atlas/api",
    "test": "npm run test:unit",
    "test:policy": "npm run test:policy -w @atlas/api",
    "test:integration": "node scripts/run-tests.mjs integration",
    "check": "npm run typecheck && npm run test:graph && npm run test:advanced-export && npm run test:unit && npm run test:ui && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:coverage": "node scripts/coverage-local.mjs full",
    "test:db": "node scripts/integration-local.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:all": "npm run qa:local",
    "test:full": "npm run qa:local",
    "test:coverage:unit": "node scripts/coverage-local.mjs unit",
    "coverage:check": "node scripts/coverage-gate.mjs",
    "test:coverage:gate": "npm run test:coverage && npm run coverage:check",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:ui": "npm run test:ui -w @atlas/web",
    "test:ui:coverage": "npm run test:ui:coverage -w @atlas/web",
    "coverage:merge": "node scripts/coverage-merge.mjs",
    "qa:local": "npm run qa:integral",
    "pilot:check": "node scripts/pilot-check.mjs",
    "pilot:start": "npm run pilot:check && node scripts/pilot-artifacts.mjs && concurrently -k -n API,WEB -c cyan,green \"npm run start:api\" \"npm run preview -w @atlas/web\"",
    "coverage:backlog": "node scripts/coverage-backlog.mjs",
    "test:qa-tools": "node --test scripts/coverage-backlog.test.mjs scripts/coverage-suite.test.mjs scripts/coverage-target.test.mjs scripts/qa-integral.test.mjs scripts/coverage-layers.test.mjs scripts/qa-uml.test.mjs",
    "coverage:check:90": "node scripts/coverage-milestone-90.mjs",
    "qa:milestone90": "npm run qa:integral",
    "db:restore:verify": "node scripts/restore-db.mjs --mode=verify",
    "db:restore:recover": "node scripts/restore-db.mjs --mode=recover",
    "qa:v1:functional": "npm run typecheck && npm run test:unit && npm run test:ui && npm run test:db && npm run test:e2e:local && npm run build",
    "pilot:build": "npm run pilot:check && npm run build",
    "test:graph": "node scripts/graph-regression.cjs",
    "test:advanced-export": "node --test scripts/advanced-export-regression.cjs",
    "test:export": "node node_modules/tsx/dist/cli.mjs --test apps/api/src/modules/exports/provenance.unit.test.ts apps/api/src/modules/exports/raster-export.unit.test.ts apps/api/src/modules/exports/advanced-document.unit.test.ts apps/api/src/modules/exports/diagram-documents.unit.test.ts apps/api/src/modules/licensing/licensing.unit.test.ts",
    "qa:integral": "node scripts/qa-integral.mjs",
    "qa:uml": "node scripts/qa-uml.mjs",
    "qa:uml:clases": "node scripts/qa-uml.mjs clases",
    "qa:uml:objetos": "node scripts/qa-uml.mjs objetos",
    "qa:uml:componentes": "node scripts/qa-uml.mjs componentes",
    "qa:uml:estructura-compuesta": "node scripts/qa-uml.mjs estructura-compuesta",
    "qa:uml:despliegue": "node scripts/qa-uml.mjs despliegue",
    "qa:uml:paquetes": "node scripts/qa-uml.mjs paquetes",
    "qa:uml:perfiles": "node scripts/qa-uml.mjs perfiles",
    "qa:uml:casos-de-uso": "node scripts/qa-uml.mjs casos-de-uso",
    "qa:uml:actividades": "node scripts/qa-uml.mjs actividades",
    "qa:uml:estados": "node scripts/qa-uml.mjs estados",
    "qa:uml:secuencia": "node scripts/qa-uml.mjs secuencia",
    "qa:uml:comunicacion": "node scripts/qa-uml.mjs comunicacion",
    "qa:uml:vista-interaccion": "node scripts/qa-uml.mjs vista-interaccion",
    "qa:uml:tiempos": "node scripts/qa-uml.mjs tiempos",
    "qa:uml:clases:rapido": "node scripts/qa-uml.mjs clases --fast"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "@playwright/test": "^1.56.0",
    "c8": "^12.0.0"
  }
}
