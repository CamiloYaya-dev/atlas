{
  "name": "@atlas/api",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test src/domain/document.test.ts",
    "test:integration": "tsx --test src/tests/integration.test.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "admin:status": "tsx src/db/admin-status.ts",
    "test:policy": "tsx --test src/domain/access-policy.test.ts"
  },
  "dependencies": {
    "@atlas/contracts": "*",
    "@atlas/fixtures": "*",
    "fastify": "^5.2.0",
    "pg": "^8.16.0",
    "dotenv": "^16.5.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "tsup": "^8.5.0"
  }
}
